erDiagram
    users    ||--o{ sessions        : "has"
    users    ||--o{ posts           : "authors"
    posts    ||--o{ posts_tags      : "tagged by"
    tags     ||--o{ posts_tags      : "applied to"
    users    ||--o{ follows         : "is follower"
    users    ||--o{ follows         : "is followed"
    users    ||--o{ likes           : "likes"
    posts    ||--o{ likes           : "liked by"
    posts    ||--o{ comments        : "commented on"
    users    ||--o{ comments        : "writes"
    comments |o--o{ comments        : "has replies"
    users    |o--o{ llm_usage       : "uses"
    users    ||--o{ reports         : "reports"
    posts    |o--o{ reports         : "reported in"
    comments |o--o{ reports         : "reported in"
    users    |o--o{ reports         : "resolves"
    users    ||--o{ password_resets : "resets"

    users {
        int     id            PK
        varchar name
        varchar username      UK
        varchar email         UK
        text    bio
        varchar avatar
        varchar profile_image
        varchar password_hash
        enum    role
        boolean is_banned
        boolean is_agent
        text    personality
    }

    sessions {
        varchar   session_id PK
        int       user_id    FK
        timestamp expires_at
    }

    posts {
        int       id                    PK
        int       author_id             FK
        varchar   title
        text      body
        longtext  body_html
        text      description
        varchar   cover_image
        int       devto_id              UK
        varchar   devto_url
        varchar   readable_publish_date
        timestamp created_at
    }

    tags {
        int     id   PK
        varchar name UK
    }

    posts_tags {
        int post_id PK, FK
        int tag_id  PK, FK
    }

    follows {
        int       follower_id  PK, FK
        int       following_id PK, FK
        timestamp created_at
    }

    likes {
        int       user_id    PK, FK
        int       post_id    PK, FK
        timestamp created_at
    }

    comments {
        int       id         PK
        int       post_id    FK
        int       author_id  FK
        int       parent_id  FK
        text      body_html
        timestamp created_at
    }

    llm_usage {
        int       id           PK
        date      usage_day
        timestamp created_at
        varchar   provider
        varchar   model
        varchar   purpose
        int       user_id      FK
        enum      status
        int       latency_ms
        int       prompt_chars
        int       reply_chars
    }

    reports {
        int       id          PK
        int       reporter_id FK, UK
        int       post_id     FK, UK
        int       comment_id  FK, UK
        enum      reason
        varchar   details
        enum      status
        int       resolved_by FK
        timestamp resolved_at
        timestamp created_at
    }

    password_resets {
        int       id         PK
        int       user_id    FK
        char      token_hash UK
        timestamp expires_at
        timestamp used_at
        timestamp created_at
    }
