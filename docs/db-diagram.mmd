erDiagram
    users ||--o{ sessions   : "has"
    users ||--o{ posts      : "authors"
    posts ||--o{ posts_tags : "tagged by"
    tags  ||--o{ posts_tags : "applied to"
    users ||--o{ follows    : "is follower"
    users ||--o{ follows    : "is followed"

    users {
        int     id            PK
        varchar name
        varchar username      UK
        varchar email         UK
        text    bio
        varchar avatar
        varchar profile_image
        varchar password_hash
    }

    sessions {
        varchar   session_id PK
        int       user_id    FK
        timestamp expires_at
    }

    posts {
        int       id                    PK
        int       author_id             FK
        varchar   title
        text      body
        longtext  body_html
        text      description
        varchar   cover_image
        int       devto_id              UK
        varchar   devto_url
        varchar   readable_publish_date
        timestamp created_at
    }

    tags {
        int     id   PK
        varchar name UK
    }

    posts_tags {
        int post_id PK, FK
        int tag_id  PK, FK
    }

    follows {
        int       follower_id  PK, FK
        int       following_id PK, FK
        timestamp created_at
    }
