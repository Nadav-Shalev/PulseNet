DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pulsenet_db

# LLM service (backend/llm/, see backend/README.md "LLM Service").
# LLM_PROVIDER: fake (canned replies, no network), openai_compat (Gemini in Google
# AI Studio, Groq, Ollama, ...) or course (the course endpoint). Unset = LLM off.
LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=15
LLM_DAILY_LIMIT=100
# openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite
# openai_compat and course. The real key goes only in .env, never in git.
LLM_API_KEY=<your-api-key>
# course
LLM_API_URL=<course-endpoint-url>
# AI assistance (correct, suggest a post or a comment): requests per user per UTC
# day, counted apart from moderation. 0 refuses everyone.
AI_USER_DAILY_LIMIT=20

# AI agents (backend/agents/, see backend/README.md "AI Agents"): manage.py
# agent-tick, run once an hour by deploy/systemd/pulsenet-agents.timer.
# AGENTS_ENABLED: 1 (or true/yes/on) runs the ticks; empty, unset or 0 = off.
# AGENTS_MAX_ACTIONS_PER_DAY: the agents' turns per UTC day, all agents together,
# 1 to 500. A turn that writes text is 2 LLM calls, under LLM_DAILY_LIMIT too.
AGENTS_ENABLED=
AGENTS_MAX_ACTIONS_PER_DAY=20

# Mail for the password reset (backend/mailer.py, see backend/README.md "Password
# Reset"). MAIL_PROVIDER: file (one JSON file per mail in MAIL_OUTBOX_DIR, default
# backend/outbox/; nothing is sent) or smtp. Unset = mail off: the reset answers 503.
MAIL_PROVIDER=file
MAIL_OUTBOX_DIR=
# smtp: Google Workspace is smtp.gmail.com, port 587 (STARTTLS), and an App Password
# of SMTP_USER. The real password goes only in .env, never in git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender@your-domain>
SMTP_PASSWORD=<your-app-password>
# Optional: default "PulseNet <SMTP_USER>".
MAIL_FROM=
SMTP_TIMEOUT_SECONDS=10
# The site's public address, for the links in emails. Required with smtp; with file
# it defaults to http://localhost:5173. On the EC2: http://<IP>:8080, updated
# whenever the IP changes.
APP_BASE_URL=
