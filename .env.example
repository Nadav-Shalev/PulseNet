# Settings for docker compose (docker-compose.yml). Optional: without a .env file
# every value below is the default. To change one, copy this file to .env in the
# repo root (git-ignored) and edit it there.
#
# WARNING: this is a local, throwaway environment.
#   - Do NOT copy backend/.env here: it holds the credentials of your own MySQL and
#     possibly a real LLM key, and Compose does not need any of them.
#   - NEVER put production credentials here: not the course/AWS LLM key or URL,
#     not the RDS host or password, not the SMTP password. Compose has no setting
#     for the course provider or for SMTP on purpose.
# Check what Compose resolved, without printing any value:
#   python scripts/compose_preflight.py

# The site: http://localhost:<WEB_PORT>.
WEB_PORT=8080

# The MySQL container's own passwords (local only, never the RDS one).
DB_PASSWORD=pulsenet
MYSQL_ROOT_PASSWORD=pulsenet-root

# The LLM is off when LLM_PROVIDER is empty: moderation uses its word list, the AI
# buttons answer 503 and the agents only like and follow. For a free development
# model (Gemini in Google AI Studio), set openai_compat and your own dev key.
LLM_PROVIDER=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=<your-dev-key>
LLM_DAILY_LIMIT=100
LLM_TIMEOUT_SECONDS=15
AI_USER_DAILY_LIMIT=20

# The agents service (docker compose --profile agents up): on when started, one
# tick every AGENTS_TICK_SECONDS, at most AGENTS_MAX_ACTIONS_PER_DAY turns a day.
AGENTS_ENABLED=1
AGENTS_MAX_ACTIONS_PER_DAY=20
AGENTS_TICK_SECONDS=3600
